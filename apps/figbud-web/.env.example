# FigBud Global website — copy to `.env.local` for local development.
# Every value here is public (inlined into the browser bundle). Never put secrets in NEXT_PUBLIC_* variables.

# Canonical origin of this site. Production (proposed, not yet provisioned): https://figbudglobal.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Rust API origin (services/api). Also added to the Content-Security-Policy connect-src.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Only "true" in production. Anything else renders noindex and an empty sitemap.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Product website origins. Leave empty until each product site exists (Phase 4);
# product CTAs then link to the corporate Products page instead of a dead subdomain.
# Proposed: https://zirahr.figbudglobal.com · https://jasiri.figbudglobal.com · https://expense.figbudglobal.com
NEXT_PUBLIC_ZIRAHR_URL=
NEXT_PUBLIC_JASIRI_URL=
NEXT_PUBLIC_EXPENSE_NOW_URL=
