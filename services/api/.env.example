# FigBud API — copy to `.env` for local development. Never commit real secrets.

# development | staging | production
APP_ENV=development
HOST=0.0.0.0
PORT=8080
RUST_LOG=figbud_api=debug,tower_http=info,sqlx=warn

# Local Postgres from infra/docker-compose.yml (`npm run db:up`).
# On Railway this is injected from the PostgreSQL plugin: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://figbud:figbud_local_dev@localhost:5433/figbud
DATABASE_MAX_CONNECTIONS=10

# Comma-separated browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003

# Set to true only behind a trusted proxy (Railway) so X-Forwarded-For is honoured.
TRUST_PROXY=false
# Salt for hashing visitor IPs (raw IPs are never stored). REQUIRED in production.
IP_HASH_SALT=

# Abuse protection
# submissions per IP per window
ENQUIRY_RATE_LIMIT=8
ENQUIRY_RATE_WINDOW_SECS=600
# faster submissions are treated as automated
MIN_FORM_FILL_MS=2500

# --- Email ------------------------------------------------------------------
# log    = render and log emails, never send (development default; refused in production)
# hold   = store emails in the outbox and send nothing (default outside development)
# resend = deliver through Resend (requires the values below); held emails go out on start
EMAIL_MODE=log
# pending: to be supplied
RESEND_API_KEY=
# pending: verified sender, e.g. "FigBud Global <hello@<verified-domain>>"
EMAIL_FROM=
EMAIL_REPLY_TO=
# pending: CTO/team addresses, comma-separated
EMAIL_TEAM_RECIPIENTS=
# optional product routing (added to team list)
EMAIL_RECIPIENTS_ZIRAHR=
EMAIL_RECIPIENTS_JASIRI=
EMAIL_RECIPIENTS_EXPENSE_NOW=
EMAIL_RECIPIENTS_PARTNERSHIPS=
EMAIL_SEND_ACKNOWLEDGEMENTS=true
EMAIL_WORKER_INTERVAL_SECS=5

# --- Admin (passkey sign-in) ----------------------------------------------
# Origin the admin UI is served from; passkeys are bound to it. Defaults to
# http://localhost:3000 in development; admin is disabled elsewhere unless set.
ADMIN_ORIGIN=
# Optional WebAuthn relying-party id (defaults to the origin's host).
ADMIN_RP_ID=
ADMIN_SESSION_HOURS=12
