{
  "name": "@figbud/site-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "description": "Shared building blocks for FigBud Next.js sites: security headers, locale routing, cross-site links and product-site chrome",
  "exports": {
    ".": "./src/index.ts",
    "./footer": "./src/product-footer.tsx",
    "./enquiry": "./src/enquiry.ts",
    "./phone": "./src/phone.ts",
    "./server": "./src/server.ts",
    "./styles.css": "./src/styles.css",
    "./enquiry-form": "./src/enquiry-form.tsx",
    "./referral-form": "./src/referral-form.tsx",
    "./coming-soon": "./src/coming-soon.tsx",
    "./payroll-calculator": "./src/payroll-calculator.tsx",
    "./forms": "./src/forms.tsx",
    "./public-pricing": "./src/public-pricing.tsx"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@figbud/brand": "*",
    "@figbud/i18n": "*",
    "@figbud/ui": "*",
    "lucide-react": "^1",
    "next": "^16",
    "react": "^19"
  },
  "devDependencies": {
    "@types/react": "^19",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "libphonenumber-js": "^1.13.15"
  }
}
