    "./footer": "./src/product-footer.tsx",
    "./phone": "./src/phone.ts",
    "./server": "./src/server.ts",
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@figbud/brand": "*",
    "@figbud/i18n": "*",
    "@figbud/ui": "*",
    "lucide-react": "^1.62.0",
    "next": "^16.4.3",
    "react": "^19"
  },
  "devDependencies": {
    "@types/react": "^19",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "libphonenumber-js": "^1.13.15"
  }
