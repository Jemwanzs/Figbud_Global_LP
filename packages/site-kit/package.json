{
  "name": "@figbud/site-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared building blocks for FigBud Next.js sites: security headers, locale routing, cross-site links and product-site chrome",
  "exports": {
    ".": "./src/index.ts",
    "./footer": "./src/product-footer.tsx",
    "./server": "./src/server.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@figbud/brand": "*",
    "@figbud/i18n": "*",
    "@figbud/ui": "*",
    "lucide-react": "^1",
    "next": "^16",
    "react": "^19"
  },
  "devDependencies": {
    "@types/react": "^19",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
